# Uptime Kuma target (exactly 2.5.0)
KUMA_URL=http://uptime-kuma:3001
KUMA_USERNAME=mcp-reader
KUMA_PASSWORD=replace-me
# Alternative to username/password; do not set both modes.
# KUMA_JWT=
# KUMA_2FA_TOKEN=
KUMA_TLS_VERIFY=true
KUMA_CONNECT_TIMEOUT=10
KUMA_REQUEST_TIMEOUT=15

# MCP bearer-token verification
# Generate at least 32 random bytes, e.g.: openssl rand -hex 32
MCP_JWT_SECRET=replace-with-at-least-32-random-bytes
MCP_JWT_ISSUER=uptime-kuma-mcp
MCP_JWT_AUDIENCE=uptime-kuma-mcp

# Listener and request guard
MCP_PORT=8000
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
